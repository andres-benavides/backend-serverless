{
  "name": "amm-purchase-approvals-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "sam build",
    "test:coverage": "vitest run --coverage",
    "test:integration": "RUN_INTEGRATION_TESTS=1 vitest run tests/integration",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:api": "sam build && sam local start-api --docker-network sam-local --env-vars env.local.json --port 3000"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-sfn": "^3.1111.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "esbuild": "^0.25.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.0"
  }
}
